{
  // Microsoft's devcontainers/python images stop at 3.13, so there is no
  // 1-3.14-bookworm to build on. Instead the generic base provides the vscode
  // user and tooling, and uv provides the interpreter: `requires-python` in
  // pyproject.toml is then the single source of truth for the Python version.
  "name": "entsoe-grabber",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "latest"
    },
    // Explicit, and not optional. @anthropic-ai/claude-code requires Node >=22,
    // but the claude-code feature's own fallback installs Node 18 when it finds
    // no Node present -- which would leave a broken CLI. Declaring LTS (Node 24
    // as of writing) means that fallback never runs.
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    // Brings the anthropic.claude-code VS Code extension with it, so it is not
    // repeated in the extensions list below.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "containerEnv": {
    "AWS_REGION": "${localEnv:AWS_REGION:eu-central-1}",
    "AWS_DEFAULT_REGION": "${localEnv:AWS_REGION:eu-central-1}",
    "AWS_PROFILE": "${localEnv:AWS_PROFILE}",
    "AWS_ACCESS_KEY_ID": "${localEnv:AWS_ACCESS_KEY_ID}",
    "AWS_SECRET_ACCESS_KEY": "${localEnv:AWS_SECRET_ACCESS_KEY}",
    "AWS_SESSION_TOKEN": "${localEnv:AWS_SESSION_TOKEN}",
    // ENTSO-E Transparency Platform security token, forwarded from the host
    // exactly like the AWS credentials above: the secret stays on your machine
    // and only this reference is committed. Set it in your host shell profile,
    // then rebuild the container. The deployed Lambda never reads this -- it
    // takes the token from SSM Parameter Store.
    "ENTSOE_SECURITY_TOKEN": "${localEnv:ENTSOE_SECURITY_TOKEN_PROD}",
    // The .claude volume below persists credentials and settings, but Claude
    // Code keeps its onboarding state -- theme, the logged-in account, the
    // per-folder trust prompt -- in $HOME/.claude.json, which sits beside
    // that directory rather than inside it, so the volume alone does not
    // survive a rebuild. CLAUDE_CONFIG_DIR moves that file onto the volume
    // too; settings.json and .credentials.json keep the paths they had.
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "UV_LINK_MODE": "copy",
    "TF_PLUGIN_CACHE_DIR": "/home/vscode/.terraform.d/plugin-cache",
    // The workspace bind mount answers access(2) with "executable" for every
    // file, whatever mode it actually has. pre-commit's `executable` file type
    // then matches everything, and check-executables-have-shebangs -- which
    // falls back to the real mode unless core.fileMode is false -- fails every
    // file without a shebang. Git applies GIT_CONFIG_* as if passed with `-c`,
    // so this outranks the repo's own `filemode = true` without editing
    // .git/config, which lives on the mount and is shared with the host.
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fileMode",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "mounts": [
    "source=entsoe-grabber-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=entsoe-grabber-pre-commit-cache,target=/home/vscode/.cache/pre-commit,type=volume",
    "source=entsoe-grabber-tf-cache,target=/home/vscode/.terraform.d/plugin-cache,type=volume",
    "source=entsoe-grabber-claude,target=/home/vscode/.claude,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "hashicorp.terraform",
        "amazonwebservices.aws-toolkit-vscode",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "terraform.validate.enable": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true
        }
      }
    }
  }
}
