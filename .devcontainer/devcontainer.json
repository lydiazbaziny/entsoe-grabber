{
  "name": "entsoe-grabber",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest",
      "tflint": "latest"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },
    "ghcr.io/va-h/devcontainers-features/uv:1": {
      "version": "latest"
    }
  },
  "containerEnv": {
    "AWS_REGION": "${localEnv:AWS_REGION:eu-north-1}",
    "AWS_DEFAULT_REGION": "${localEnv:AWS_REGION:eu-north-1}",
    "AWS_ACCESS_KEY_ID": "${localEnv:AWS_ACCESS_KEY_ID}",
    "AWS_SECRET_ACCESS_KEY": "${localEnv:AWS_SECRET_ACCESS_KEY}",
    "AWS_SESSION_TOKEN": "${localEnv:AWS_SESSION_TOKEN}",
    "ENTSOE_SECURITY_TOKEN": "${localEnv:ENTSOE_SECURITY_TOKEN_TEST}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "UV_LINK_MODE": "copy",
    "TF_PLUGIN_CACHE_DIR": "/home/vscode/.terraform.d/plugin-cache",
    // The workspace bind mount answers access(2) with "executable" for every
    // file, whatever mode it actually has. pre-commit's `executable` file type
    // then matches everything, and check-executables-have-shebangs -- which
    // falls back to the real mode unless core.fileMode is false -- fails every
    // file without a shebang. Git applies GIT_CONFIG_* as if passed with `-c`,
    // so this outranks the repo's own `filemode = true` without editing
    // .git/config, which lives on the mount and is shared with the host.
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "core.fileMode",
    "GIT_CONFIG_VALUE_0": "false"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "mounts": [
    "source=entsoe-grabber-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=entsoe-grabber-pre-commit-cache,target=/home/vscode/.cache/pre-commit,type=volume",
    "source=entsoe-grabber-tf-cache,target=/home/vscode/.terraform.d/plugin-cache,type=volume",
    "source=entsoe-grabber-claude,target=/home/vscode/.claude,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.mypy-type-checker",
        "hashicorp.terraform",
        "amazonwebservices.aws-toolkit-vscode",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "terraform.validate.enable": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true
        }
      }
    }
  }
}
